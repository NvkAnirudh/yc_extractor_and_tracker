# Anthropic Claude API Key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Sheets Configuration
# RECOMMENDED: Use URL (more reliable than name)
GOOGLE_SHEET_URL=https://docs.google.com/spreadsheets/d/YOUR_SPREADSHEET_ID/edit
# ALTERNATIVE: Use name (less reliable, may fail even when shared correctly)
# GOOGLE_SHEET_NAME=Job_Application_Tracker
GOOGLE_CREDENTIALS_FILE=credentials.json
